class AwsProfileSwitcher < Formula
  desc "Switch AWS_PROFILE in your current shell"
  homepage "https://github.com/peterkracik/aws-profile-switcher"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/peterkracik/aws-profile-switcher/releases/download/v{{VERSION}}/aws-profile-switcher-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA256_AARCH64_APPLE_DARWIN}}"
    end
    on_intel do
      url "https://github.com/peterkracik/aws-profile-switcher/releases/download/v{{VERSION}}/aws-profile-switcher-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA256_X86_64_APPLE_DARWIN}}"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/peterkracik/aws-profile-switcher/releases/download/v{{VERSION}}/aws-profile-switcher-x86_64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA256_X86_64_UNKNOWN_LINUX_MUSL}}"
    end
  end

  def install
    bin.install "aws-profile-switcher"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/aws-profile-switcher --version")
    assert_match "awsprofile()", shell_output("#{bin}/aws-profile-switcher init zsh")
  end
end
